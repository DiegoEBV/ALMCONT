# Supabase Configuration (Backend)
# Obtén estas claves desde tu dashboard de Supabase: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Supabase Configuration (Frontend - Vite)
# IMPORTANTE: Solo usa ANON_KEY en el frontend, NUNCA service_role
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Development
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173
GPS_INGEST_TOKEN=change_this_token

# INSTRUCCIONES DE SEGURIDAD:
# 1. Copia este archivo como .env
# 2. Reemplaza los placeholders con tus claves reales
# 3. NUNCA commitees el archivo .env al repositorio
# 4. La SERVICE_ROLE_KEY solo debe usarse en el backend/servidor
# 5. En el frontend solo usa ANON_KEY con políticas RLS activas